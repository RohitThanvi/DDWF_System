# --- Server ---
ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- Auth (Vayu -> DDWF service-to-service) ---
# MUST be overridden with a real random secret (e.g. `openssl rand -hex 32`)
# before ENV=production -- app/core/config.py now refuses to start
# otherwise, on purpose (this exact placeholder is visible in the repo's
# git history, so it can never be a real production credential).
DDWF_API_KEY=change-me-to-a-long-random-secret

# --- Rate limiting (per-client, single-process; see app/core/rate_limit.py) ---
RATE_LIMIT_PER_MINUTE=60

# --- Model checkpoints ---
# Downscaler is the model DDWF actually trains/serves (Option B design).
DOWNSCALER_CHECKPOINT=./checkpoints/diffusion_downscaler_v1.pt
DEVICE=cpu   # cpu | cuda | mps

# --- Coarse forecast source (Option B: Open-Meteo, free, no API key) ---
COARSE_FORECAST_PROVIDER=open-meteo
COARSE_GRID_SIZE=8
MAX_HORIZON_DAYS=16

# --- Optional SFNO upgrade path (Option A) — unused by default ---
GLOBAL_ENGINE_CHECKPOINT=./checkpoints/sfno_global_v1.pt

# --- Data lake ---
ZARR_STORE_URI=s3://ddwf-data-lake/era5.zarr
DEM_STORE_URI=s3://ddwf-data-lake/copernicus_glo30.zarr
CACHE_DIR=./data/cache
TRAJECTORY_CACHE_TTL_HOURS=6

# --- Redis (trajectory + result caching) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage credentials (S3-compatible) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Experiment tracking ---
MLFLOW_TRACKING_URI=./mlruns
